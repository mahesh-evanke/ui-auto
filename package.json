    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"var fs=require('fs');var d='dist/src/init';fs.mkdirSync(d,{recursive:true});fs.copyFileSync('LEGACY_GHERKIN_STEP_DEFINITIONS.md',d+'/GHERKIN_STEP_DEFINITIONS.md');\"",
        "wdio": "wdio run ./e2e/config/wdio.conf.ts",
        "checkNum": "ts-node e2e/support/misc-utils/FeatureFileReport.ts",
        "test": "ts-node ./e2e/config/test.ts",
        "repl": "npx wdio repl chrome",
        "webio": "node webio/cli.js",
        "webio:generate": "node webio/generate-feature.js",
        "webio:generate-locators": "node webio/generate-locators-and-features.js"
    },
    "dependencies": {
        "axios": "^1.13.5"
    }
}
