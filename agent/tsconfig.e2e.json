{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist-e2e",
    "rootDir": ".",
    "moduleResolution": "node"
  },
  "include": ["e2e/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-e2e", "app", "lib"]
}
