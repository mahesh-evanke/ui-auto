# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored; never commit real credentials.

# GitHub OAuth App credentials (github.com/settings/developers -> New OAuth App)
# Callback URL must be: http://localhost:3000/api/auth/callback/github
# Only needed for the web UI (`npm run web`); the CLI does not use these.
GITHUB_ID=
GITHUB_SECRET=

# Random secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Local Ollama
OLLAMA_HOST=http://localhost:11434
TESTPILOT_MODEL=llama3.2

# Reference test-automation framework studied for step-definition vocabulary.
# Leave unset: it defaults to this repository's own e2e/ directory, which is
# also the harness that runs the generated tests.
# TESTPILOT_REFERENCE_FRAMEWORK_PATH=
