        "@wdio/types": "9.23.2",
        "chai": "^4.5.0",
        "chai-as-promised": "^7.1.1",
        "edgedriver": "^6.1.1",
        "fs-extra": "^11.3.0",
        "glob": "^11.0.1",
        "js-yaml": "^4.1.0",
        "moment": "^2.30.1",
        "multiple-cucumber-html-reporter": "^1.18.3",
